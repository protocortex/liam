# Rust build artifacts
/target/
**/*.rs.bk

# macOS
.DS_Store

# Local liam data / model cache
*.db
*.db-shm
*.db-wal
# the store's advisory lock, created next to the database by any local run
*.db.lock
/.liam/
# fastembed's own reranker cache lands here (crate-relative), not under
# ~/.cache/huggingface, when a crate's working directory is the crate root
**/.fastembed_cache/
.claude/designs/
.claude/plans/
.claude/implement/
.claude/worktrees/
